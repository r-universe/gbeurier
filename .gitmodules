[submodule ".registry"]
	path = .registry
	url = https://github.com/gbeurier/gbeurier.r-universe.dev
	branch = HEAD
[submodule "dagml"]
	path = dagml
	url = https://github.com/GBeurier/dag-ml
	branch = d796152c148db3bb3f4398f818e1083f5e3aa816
	subdir = bindings/r
[submodule "dagmldata"]
	path = dagmldata
	url = https://github.com/GBeurier/dag-ml-data
	branch = 8c86f13d3ff1c3fbdba94e18d73d4c2b367320c3
	subdir = crates/dag-ml-data-r
[submodule "n4m"]
	path = n4m
	url = https://github.com/GBeurier/nirs4all-methods
	branch = 70b631cc36d0fed830bcacd34dd7bc4291a30dc3
	subdir = bindings/r/n4m
[submodule "nirs4all"]
